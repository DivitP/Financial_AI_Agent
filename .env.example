# Copy this file to .env for live-provider development. Do not commit .env.

# Application runtime
FINANCIAL_AI_APP_ENVIRONMENT=development
FINANCIAL_AI_HOST=127.0.0.1
PORT=8501
FINANCIAL_AI_DEBUG=false
PERSIST_DIR=data/runtime
FINANCIAL_AI_DATABASE_PATH=data/runtime/financial_ai.db
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=15
PROVIDER_RATE_LIMIT_PER_MINUTE=30

# Feature flags: leave disabled to run offline tests without credentials.
ENABLE_GROQ=false
ENABLE_FMP=false
ENABLE_KRONOS=false
ENABLE_LOCAL_LLM=false

# Optional live-provider credentials. Supply values only when enabling the provider.
# GROQ_API_KEY=
# FMP_API_KEY=

# Configurable model identifiers
GROQ_MODEL=llama-3.3-70b-versatile
LOCAL_LLM_MODEL=qwen3:8b
# Ollama-compatible endpoint. Only needed when ENABLE_LOCAL_LLM=true.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_CACHE_DIR=data/runtime/kronos
KRONOS_SOURCE_DIR=data/runtime/kronos/source
KRONOS_DEVICE=cpu
# Reserved for an explicit future download command; startup never downloads.
KRONOS_ALLOW_DOWNLOADS=false
KRONOS_TIMEOUT_SECONDS=120
KRONOS_MAX_RETRIES=1
# Optional path to a PromotionPolicy JSON file; omitted means experimental only.
# KRONOS_POLICY_PATH=data/runtime/kronos/promotion-policy.json

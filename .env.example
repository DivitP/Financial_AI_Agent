# Copy this file to .env for live-provider development. Do not commit .env.

# Application runtime
FINANCIAL_AI_APP_ENVIRONMENT=development
FINANCIAL_AI_HOST=127.0.0.1
PORT=8501
FINANCIAL_AI_DEBUG=false
PERSIST_DIR=data/runtime
FINANCIAL_AI_DATABASE_PATH=data/runtime/financial_ai.db
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=15
PROVIDER_RATE_LIMIT_PER_MINUTE=30

# Feature flags: leave disabled to run offline tests without credentials.
ENABLE_GROQ=false
ENABLE_FMP=false
ENABLE_KRONOS=false
ENABLE_LOCAL_LLM=false

# Replacement worker opt-in. Default remains offline/no provider requests.
ENABLE_LIVE_RESEARCH=false
# Optional richer offline samples: select this factory explicitly, not the live factory.
# WORKER_HANDLER_FACTORY=financial_ai.workflow.synthetic:handler
# Browser-reachable API or same-origin proxy; no credentials/path/query allowed.
SYNTHETIC_EVIDENCE_ORIGIN=http://localhost:8000
# SEC_USER_AGENT=YourApplication your-real-contact@example.com
# RESEARCH_NEWS_FEEDS=["https://approved-publisher.example/feed.xml"]
# Add the reviewed feed hostname to DOCUMENT_ALLOWED_HOSTS as well.

# Optional live-provider credentials. Supply values only when enabling the provider.
# GROQ_API_KEY=
# FMP_API_KEY=

# Configurable model identifiers
GROQ_MODEL=openai/gpt-oss-120b
LOCAL_LLM_MODEL=qwen3:8b
# Ollama-compatible endpoint. Only needed when ENABLE_LOCAL_LLM=true.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_CACHE_DIR=data/runtime/kronos
KRONOS_SOURCE_DIR=data/runtime/kronos/source
KRONOS_DEVICE=cpu
# Reserved for an explicit future download command; startup never downloads.
KRONOS_ALLOW_DOWNLOADS=false
KRONOS_TIMEOUT_SECONDS=120
KRONOS_MAX_RETRIES=1
# Optional path to a PromotionPolicy JSON file; omitted means experimental only.
# KRONOS_POLICY_PATH=data/runtime/kronos/promotion-policy.json
# Browser boundary: JSON arrays; use your exact HTTPS origin/hostname in deployment.
# ALLOWED_BROWSER_ORIGINS=["https://research.example.com"]
# ALLOWED_HOSTS=["research.example.com"]
# Explicit download hosts; adding a feed does not automatically trust its hostname.
# DOCUMENT_ALLOWED_HOSTS=["www.sec.gov","data.sec.gov","api.gdeltproject.org","investor.example.com"]
# Local application safety budgets (not provider plan allowances).
API_REQUESTS_PER_MINUTE=120
API_CONCURRENCY=16
MAX_PENDING_JOBS=20
MAX_RUNNING_JOBS=2
RUN_CALL_BUDGET=60
RUN_ARTICLE_BUDGET=20
RUN_MODEL_BUDGET=8
PROVIDER_CONCURRENCY=2
MAX_RETRY_DELAY_SECONDS=10
# Optional scaled profile; local mode needs no Redis or Postgres.
DEPLOYMENT_PROFILE=local
# DATABASE_URL=postgresql://research:REPLACE_ME@127.0.0.1:5432/research
# REDIS_URL=redis://127.0.0.1:6379/0
# WORKER_HANDLER_FACTORY=your_trusted_package.worker:handler
# REDIS_STREAM=financial-ai:jobs
# WORKER_RECLAIM_SECONDS=60
# Content-free traces to a local OpenTelemetry collector (optional observability extra).
# No export or collector is required for persisted timings, metrics, or audit history.
TELEMETRY_EXPORT_ENABLED=false
TELEMETRY_RETENTION_DAYS=7
